            "zh-CN": "球径 Dw",
            "en-US": "Ball Diameter Dw"
          },
          "help": {
            "zh-CN": "球径改变接触曲率、几何电场扩展和滚动体间距。",
            "en-US": "Ball diameter changes contact curvature, field spreading, and ball spacing."
          }
        },
        {
          "name": "pitch_diameter_mm",
          "kind": "number",
          "step": "any",
          "unit": "mm",
          "label": {
            "zh-CN": "节圆直径 / PCD",
            "en-US": "Pitch Diameter / PCD"
          },
          "help": {
            "zh-CN": "PCD 进入接触运动学和载荷分布几何。",
            "en-US": "Pitch diameter enters contact kinematics and the load-distribution geometry."
          }
        },
        {
          "name": "rolling_elements",
          "kind": "number",
          "step": "1",
          "unit": "pcs",
          "label": {
            "zh-CN": "滚动体数量 Z",
            "en-US": "Rolling Elements Z"
          },
          "help": {
            "zh-CN": "加载滚动体数决定并联通路数量。",
            "en-US": "The number of loaded balls controls the number of parallel current paths."
          }
        },
        {
          "name": "radial_clearance_mm",
          "kind": "number",
          "step": "any",
          "unit": "mm",
          "label": {
            "zh-CN": "初始径向游隙",
            "en-US": "Initial Radial Clearance"
          },
          "help": {
            "zh-CN": "程序会再扣除配合损失和热损失得到运行游隙。",
            "en-US": "The solver subtracts fit and thermal losses to get the operating clearance."
          }
        },
        {
          "name": "inner_curvature_coeff",
          "kind": "number",
          "step": "any",
          "unit": "-",
          "label": {
            "zh-CN": "内圈曲率系数 fi",
            "en-US": "Inner Curvature fi"
          },
          "help": {
            "zh-CN": "用于 Hertz 接触椭圆和有效接触半径计算。",
            "en-US": "Used in Hertzian ellipse and effective contact radius calculations."
          }
        },
        {
          "name": "outer_curvature_coeff",
          "kind": "number",
          "step": "any",
          "unit": "-",
          "label": {
            "zh-CN": "外圈曲率系数 fe",
            "en-US": "Outer Curvature fe"
          },
          "help": {
            "zh-CN": "用于外圈点接触刚度和接触面积求解。",
            "en-US": "Used for outer-race point-contact stiffness and area."
          }
        },
        {
          "name": "composite_roughness_um",
          "kind": "number",
          "step": "any",
          "unit": "μm",
          "label": {
            "zh-CN": "综合粗糙度",
            "en-US": "Composite Roughness"
          },
          "help": {
            "zh-CN": "粗糙度同时进入 λ 比和薄膜有效间隙修正。",
            "en-US": "Roughness enters both lambda ratio and the thin-film effective-gap correction."
          }
        }
      ]
