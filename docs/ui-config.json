          },
          "help": {
            "zh-CN": "用于求解钢圈与陶瓷球的等效模量。",
            "en-US": "Used in the equivalent modulus between the steel race and ceramic ball."
          }
        },
        {
          "name": "ceramic_youngs_modulus_mpa",
          "kind": "number",
          "step": "any",
          "unit": "MPa",
          "label": {
            "zh-CN": "陶瓷球弹性模量",
            "en-US": "Ceramic Young's Modulus"
          },
          "help": {
            "zh-CN": "影响接触刚度、变形量和 Hertz 接触面积。",
            "en-US": "Changes stiffness, deformation, and Hertzian contact area."
          }
        },
        {
          "name": "ceramic_poisson_ratio",
          "kind": "number",
          "step": "any",
          "unit": "-",
          "label": {
            "zh-CN": "陶瓷球泊松比",
            "en-US": "Ceramic Poisson Ratio"
          },
          "help": {
            "zh-CN": "和模量一起决定陶瓷接触的机械响应。",
            "en-US": "Works with the elastic modulus to set the ceramic contact response."
