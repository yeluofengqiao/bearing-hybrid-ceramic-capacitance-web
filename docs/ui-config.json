  "groups": [
    {
      "id": "operating",
      "title": {
        "zh-CN": "工况与频率",
        "en-US": "Operating Conditions"
      },
      "description": {
        "zh-CN": "转速、载荷、双侧温度和单点频率决定膜厚、分压和阻抗读数。",
        "en-US": "Speed, load, dual ring temperatures, and spot frequency drive film thickness, voltage split, and impedance."
      },
      "fields": [
        {
          "name": "speed_rpm",
          "kind": "number",
          "step": "any",
          "unit": "rpm",
          "label": {
            "zh-CN": "转速 n",
            "en-US": "Speed n"
          },
          "help": {
            "zh-CN": "卷吸速度越高，通常油膜越厚，油膜电容会减小。",
            "en-US": "Higher entrainment speed usually thickens the film and reduces oil-film capacitance."
          }
        },
        {
          "name": "radial_load_n",
          "kind": "number",
          "step": "any",
          "unit": "N",
          "label": {
            "zh-CN": "径向载荷 Fr",
            "en-US": "Radial Load Fr"
          },
          "help": {
            "zh-CN": "径向载荷直接改变加载滚动体数量和接触椭圆面积。",
            "en-US": "Radial load changes the number of loaded balls and the Hertzian contact area."
          }
        },
        {
          "name": "axial_load_n",
          "kind": "number",
          "step": "any",
          "unit": "N",
          "label": {
            "zh-CN": "轴向载荷 Fa",
            "en-US": "Axial Load Fa"
          },
          "help": {
            "zh-CN": "轴向载荷通过接触角耦合进入滚动体载荷分布。",
            "en-US": "Axial load enters the rolling-element load distribution through contact angle."
          }
        },
        {
          "name": "axial_preload_n",
          "kind": "number",
          "step": "any",
          "unit": "N",
          "label": {
            "zh-CN": "轴向预紧",
            "en-US": "Axial Preload"
          },
          "help": {
            "zh-CN": "预紧会抬高等效轴向载荷并缩小运行游隙。",
            "en-US": "Preload raises the effective axial load and shrinks operating clearance."
          }
        },
        {
          "name": "inner_ring_temp_c",
          "kind": "number",
          "step": "any",
          "unit": "°C",
          "label": {
            "zh-CN": "内圈温度",
            "en-US": "Inner Ring Temp"
          },
          "help": {
            "zh-CN": "单独建模内圈温度，允许内外圈存在温差。",
            "en-US": "Inner ring temperature is modeled independently so the two rings may differ."
          }
        },
        {
          "name": "outer_ring_temp_c",
          "kind": "number",
          "step": "any",
          "unit": "°C",
          "label": {
            "zh-CN": "外圈温度",
            "en-US": "Outer Ring Temp"
          },
          "help": {
            "zh-CN": "外圈温度影响外圈油膜粘度、密度和介电修正。",
            "en-US": "Outer ring temperature modifies outer-film viscosity, density, and permittivity."
          }
        },
        {
          "name": "applied_voltage_v",
          "kind": "number",
          "step": "any",
          "unit": "V",
          "label": {
            "zh-CN": "施加总电压",
            "en-US": "Applied Voltage"
          },
          "help": {
            "zh-CN": "三段分压和等效场强都按这个总电压计算。",
            "en-US": "Voltage split and equivalent electric field are computed from this total voltage."
          }
        },
        {
          "name": "single_frequency_hz",
          "kind": "number",
          "step": "any",
          "unit": "Hz",
          "label": {
            "zh-CN": "单点频率",
            "en-US": "Spot Frequency"
          },
          "help": {
            "zh-CN": "单点阻抗使用纯电容等效阻抗，不包含泄漏电阻。",
            "en-US": "Single-point impedance uses pure capacitive impedance without leakage resistance."
          }
        },
        {
          "name": "fit_clearance_loss_um",
          "kind": "number",
          "step": "any",
          "unit": "μm",
          "label": {
            "zh-CN": "配合游隙损失",
            "en-US": "Fit Clearance Loss"
          },
          "help": {
            "zh-CN": "用于表示装配配合造成的初始游隙损失。",
            "en-US": "Represents clearance loss caused by fit-up and assembly."
          }
        },
        {
          "name": "thermal_clearance_loss_um",
          "kind": "number",
          "step": "any",
          "unit": "μm",
          "label": {
            "zh-CN": "热游隙损失",
            "en-US": "Thermal Clearance Loss"
          },
          "help": {
            "zh-CN": "用于表示热膨胀导致的运行游隙损失。",
            "en-US": "Represents operating clearance loss caused by thermal growth."
          }
        }
      ]
    },
    {
